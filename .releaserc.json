{
  "//": "Configuration de semantic-release. La version est DEDUITE des messages de commit conventionnels (docs/03 §2.2) : fix -> patch, feat -> mineure, BREAKING CHANGE -> majeure. Repond a la faiblesse f4 de l'audit : plus de 0.0.1-SNAPSHOT fige, plus de tag pose a la main.",
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "build", "release": "patch" },
          { "type": "ci", "release": false },
          { "type": "docs", "release": false },
          { "type": "test", "release": false },
          { "type": "refactor", "release": "patch" },
          { "type": "perf", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Fonctionnalités" },
            { "type": "fix", "section": "Corrections" },
            { "type": "perf", "section": "Performances" },
            { "type": "refactor", "section": "Refactorisations" },
            { "type": "build", "section": "Construction et dépendances" },
            { "type": "ci", "section": "Intégration continue", "hidden": true },
            { "type": "docs", "section": "Documentation", "hidden": true },
            { "type": "test", "section": "Tests", "hidden": true },
            { "type": "chore", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Journal des versions\n\nCe fichier est genere automatiquement par semantic-release a partir des messages de commit conventionnels. Ne pas le modifier a la main."
      }
    ],
    "@semantic-release/github",
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md"],
        "message": "chore(release): publier la version ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
