# --- Frontend (Angular) ---
app/front/node_modules/
app/front/dist/
app/front/.angular/
app/front/coverage/

# --- Backend (Gradle / Spring Boot) ---
app/back/.gradle/
app/back/build/
app/back/bin/

# --- Terraform ---
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# --- Rapports & artefacts locaux ---
reports/
backups/
*.log

# EXCEPTION : les preuves d'exécution sont des LIVRABLES, pas des artefacts
# locaux. La règle « *.log » ci-dessus avait silencieusement exclu les traces
# de la démonstration de rollback, alors que le README les référence — les
# liens du dépôt public pointaient donc dans le vide.
# Tout ce qui se trouve sous docs/captures/ est versionné, sans exception.
!docs/captures/**

# --- Secrets : AUCUN credential ne doit être versionné ---
.env
.env.*
*.pem
*.key
*.p12
kubeconfig
secrets.yaml
!helm/**/secrets.example.yaml

# --- Éditeurs / OS ---
.idea/
.DS_Store
Thumbs.db

# --- Artefacts Python ---
__pycache__/
*.pyc
node_modules/
